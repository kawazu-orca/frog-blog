---
import {
	formatDateWithSlash,
	type PublishedPost,
} from "../lib/notion";
import { renderInlineMathText } from "../lib/renderer";

interface Props {
	posts: PublishedPost[];
	label: string;
	showHeader?: boolean;
}

const { posts, label, showHeader = true } = Astro.props as Props;
---

<section class="article-toggle-list-wrap" aria-label={label}>
	{showHeader && (
		<div class="article-toggle-head" aria-hidden="true">
			<span class="article-toggle-head-date">/Date</span>
			<span class="article-toggle-head-title">/Title</span>
			<span class="article-toggle-head-tag">/Tag</span>
		</div>
	)}
	<div class="article-toggle-list">
		{
			posts.map((post) => {
				return (
					<article class="article-toggle-item">
						<a class="article-toggle-row article-toggle-link" href={`/posts/${post.slug}`}>
							<div class="article-toggle-date-block">
								<time class="article-toggle-date" datetime={post.date ?? ""}>
									{formatDateWithSlash(post.date) ?? "日付なし"}
								</time>
							</div>
							<div class="article-toggle-heading">
								<h2 class="article-toggle-title" set:html={renderInlineMathText(post.title)} />
							</div>
							<div class="article-toggle-meta">
								{post.tags.length > 0 && (
									<span class="article-toggle-tags">
										{post.tags.map((tag) => (
											<span class="tag-badge">{tag}</span>
										))}
									</span>
								)}
							</div>
						</a>
					</article>
				);
			})
		}
	</div>
</section>
