---
interface Props {
	variant?: "default" | "narrow" | "diary";
}

const { variant = "default" } = Astro.props as Props;
const path = Astro.url.pathname;
const currentSection = path.startsWith("/diary")
	? "diary"
	: path.startsWith("/articles") || path.startsWith("/posts")
		? "articles"
		: "";
---

<header class="site-header">
	<div class={`header-inner${variant !== "default" ? ` header-inner--${variant}` : ""}`}>
		<a href="/" class="site-logo">frog-blog</a>
		<nav class="site-nav">
			<a href="/diary" aria-current={currentSection === "diary" ? "page" : undefined}>
				DIARY
			</a>
			<a href="/articles" aria-current={currentSection === "articles" ? "page" : undefined}>
				ARTICLES
			</a>
			<button
				type="button"
				class="theme-toggle"
				aria-label="ダークモード切り替え"
				title="ダークモード切り替え"
			>
				<svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true">
					<path
						fill="currentColor"
						d="M21 13.2A9 9 0 1 1 10.8 3a7 7 0 1 0 10.2 10.2Z"
					></path>
				</svg>
				<svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true">
					<g
						fill="none"
						stroke="currentColor"
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
					>
						<circle cx="12" cy="12" r="5" fill="currentColor" stroke="none"></circle>
						<path d="M12 2v2"></path>
						<path d="M12 20v2"></path>
						<path d="m4.93 4.93 1.41 1.41"></path>
						<path d="m17.66 17.66 1.41 1.41"></path>
						<path d="M2 12h2"></path>
						<path d="M20 12h2"></path>
						<path d="m6.34 17.66-1.41 1.41"></path>
						<path d="m19.07 4.93-1.41 1.41"></path>
					</g>
				</svg>
			</button>
		</nav>
	</div>
</header>

<script is:inline>
	const syncThemeToggle = () => {
		const button = document.querySelector(".theme-toggle");
		if (!(button instanceof HTMLButtonElement)) return;
		const isDark = document.documentElement.dataset.theme === "dark";
		button.setAttribute("aria-pressed", String(isDark));
		button.title = isDark ? "ライトモードに切り替え" : "ダークモードに切り替え";
	};

	const toggleTheme = () => {
		const current = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
		const next = current === "dark" ? "light" : "dark";
		document.documentElement.dataset.theme = next;
		try {
			localStorage.setItem("theme", next);
		} catch {
			// ignore
		}
		window.dispatchEvent(new CustomEvent("themechange", { detail: next }));
		syncThemeToggle();
	};

	const initThemeToggle = () => {
		const button = document.querySelector(".theme-toggle");
		if (!(button instanceof HTMLButtonElement)) return;
		button.addEventListener("click", toggleTheme);
		syncThemeToggle();
	};

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initThemeToggle);
	} else {
		initThemeToggle();
	}
</script>
